# Store text with LF in the repository regardless of the contributor's platform, so
# `core.autocrlf=true` on Windows does not rewrite line endings on every commit and
# produce spurious diffs.
* text=auto eol=lf

# Explicit: the shipped database and the UTF-16LE test fixture must never be treated as
# text. Git's NUL-byte sniffing already classifies both as binary, but relying on a
# heuristic for a committed artifact is not worth the risk.
*.db     binary
*.db-journal binary
*.db-wal binary
*.db-shm binary
