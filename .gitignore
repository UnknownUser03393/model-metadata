# SQLite side files: the shipped DB must be readable standalone (journal_mode=DELETE,
# VACUUMed), so these must never be committed.
*.db-journal
*.db-wal
*.db-shm

__pycache__/
*.py[cod]
.venv/

# The snapshot under snapshot/ IS committed on purpose. Unlike the previous dataset there
# is no upstream URL to refetch it from -- it is the output of a curation pipeline -- so
# the JSON in the tree is the source of truth and the database is a derived index.
