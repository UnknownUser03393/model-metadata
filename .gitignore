# SQLite side files: the shipped DB must be readable standalone (journal_mode=DELETE,
# VACUUMed), so these must never be committed.
*.db-journal
*.db-wal
*.db-shm

__pycache__/
*.py[cod]
.venv/

# The upstream snapshot is an input, not an artifact: its content is preserved verbatim
# in the raw_record table, and `update` can refetch it. Keeping it out of the repo avoids
# shipping a 6 MB non-diffable UTF-16 file next to the database that supersedes it.
model_metadata.json
